# Gere uma chave aleatória para produção. Nunca use o valor de desenvolvimento.
DJANGO_SECRET_KEY=change-me-in-production
# Produção: false
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173,https://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
# true se o frontend for HTTPS (ex.: Vite basic-ssl / celular na LAN)
JWT_COOKIE_SECURE=false
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nina — LLM OpenAI-compatível (obrigatório para o cérebro ANS)
# Exemplo OpenAI:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Exemplo DeepSeek:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat
# Exemplo Groq:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b
