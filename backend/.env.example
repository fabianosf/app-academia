# Gere uma chave aleatória para produção. Nunca use o valor de desenvolvimento.
DJANGO_SECRET_KEY=change-me-in-production
# Produção: false
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173,https://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
# true se o frontend for HTTPS (ex.: Vite basic-ssl / celular na LAN)
JWT_COOKIE_SECURE=false
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nina — LLM OpenAI-compatível (obrigatório para o cérebro ANS)
# Exemplo OpenAI:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Exemplo DeepSeek:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat
# Exemplo Groq:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b

# Pesquisa web (adapter HTTP genérico). Vazio = search_unavailable (honesto).
# WEB_SEARCH_PROVIDER=http
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=

# Geração de vídeo avatar. Vazio = not_configured.
# Opção A — local (grátis, só para testar o fluxo; vídeo placeholder com passos):
VIDEO_DEMO_PROVIDER=local
# Opção B — HeyGen nativo:
# VIDEO_DEMO_PROVIDER=heygen
# VIDEO_DEMO_API_KEY=sua_chave_heygen
# VIDEO_DEMO_AVATAR_NEUTRAL=avatar_id_do_dashboard
# VIDEO_DEMO_AVATAR_WOMAN=
# VIDEO_DEMO_AVATAR_MAN=
# VIDEO_DEMO_VOICE_NEUTRAL=
# VIDEO_DEMO_VOICE_WOMAN=
# VIDEO_DEMO_VOICE_MAN=
# Opção C — gateway HTTP genérico:
# VIDEO_DEMO_PROVIDER=http
# VIDEO_DEMO_API_KEY=
# VIDEO_DEMO_BASE_URL=   # POST {BASE}/generate  GET {BASE}/jobs/{id}
VIDEO_DEMO_API_KEY=
VIDEO_DEMO_BASE_URL=
VIDEO_DEMO_AVATAR_NEUTRAL=
VIDEO_DEMO_AVATAR_WOMAN=
VIDEO_DEMO_AVATAR_MAN=
VIDEO_DEMO_VOICE_NEUTRAL=
VIDEO_DEMO_VOICE_WOMAN=
VIDEO_DEMO_VOICE_MAN=
# Demos ~7s. Vídeos novos ficam em status review até staff aprovar.

# Live: não há env global — define stream_url / streamUrl por aula (admin ou API staff).
# Movimento: MediaPipe no browser; API só recebe métricas com consentimento (sem frames).

# Ver docs/INTEGRACOES_ASSISTENTE.md
